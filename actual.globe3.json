{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Interactive globe showing clinical trials and connections between countries",
  "width": 600,
  "height": 600,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": {
    "top": 20,
    "bottom": 20
  },
  "signals": [
    {
      "name": "tx", 
      "update": "width / 2"
    },
    {
      "name": "ty", 
      "update": "height / 2"
    },
    {
      "name": "scale", 
      "value": 250
    },
    {
      "name": "sensitivity",
      "value": 0.25,
      "description": "Controls rotation sensitivity"
    },
    {
      "name": "hover",
      "value": null,
      "on": [
        {
          "events": "@country-bubbles:mouseover",
          "update": "datum.Country"
        },
        {
          "events": "@country-bubbles:mouseout",
          "update": "null"
        }
      ]
    },
    {
      "name": "angles",
      "value": [0, 0],
      "on": [
        {"events": "pointerdown", "update": "[rotateX, rotateY]"}
      ]
    },
    {
      "name": "cloned",
      "value": null,
      "on": [
        {"events": "pointerdown", "update": "copy('projection')"}
      ]
    },
    {
      "name": "start",
      "value": null,
      "on": [
        {"events": "pointerdown", "update": "xy()"}
      ]
    },
    {
      "name": "drag",
      "value": null,
      "on": [
        {"events": "[pointerdown, window:pointerup] > window:pointermove", "update": "xy()"}
      ]
    },
    {
      "name": "delta",
      "value": null,
      "on": [
        {"events": {"signal": "drag"}, "update": "[drag[0] - start[0], drag[1] - start[1]]"}
      ]
    },
    {
      "name": "rotateX",
      "value": 0,
      "on": [
        {"events": {"signal": "delta"}, "update": "(angles[0] + delta[0] * sensitivity) % 360"}
      ]
    },
    {
      "name": "rotateY",
      "value": 0,
      "on": [
        {"events": {"signal": "delta"}, "update": "clamp(angles[1] - delta[1] * sensitivity, -90, 90)"}
      ]
    }
  ],
  "projections": [
    {
      "name": "projection",
      "type": "orthographic",
      "scale": {"signal": "scale"},
      "rotate": [{"signal": "rotateX"}, {"signal": "rotateY"}, 0],
      "translate": [{"signal": "tx"}, {"signal": "ty"}]
    }
  ],
  "data": [
    {
      "name": "sphere",
      "values": [{"type": "Sphere"}]
    },
    {
      "name": "world",
      "url": "https://vega.github.io/vega/data/world-110m.json",
      "format": {"type": "topojson", "feature": "countries"}
    },
    {
      "name": "dataset"
    },
    {
      "name": "countries-data",
      "source": "dataset",
      "transform": [
        {
          "type": "filter", 
          "expr": "isValid(datum.Country) && isValid(datum.lat) && isValid(datum.lon) && isValid(datum.ClinicalTrials) && datum.ClinicalTrials > 0"
        },
        {
          "type": "aggregate",
          "groupby": ["Country", "lat", "lon"],
          "ops": ["sum"],
          "fields": ["ClinicalTrials"],
          "as": ["TotalTrials"]
        }
      ]
    },
    {
      "name": "country-nodes",
      "source": "countries-data",
      "transform": [
        {
          "type": "geopoint", 
          "projection": "projection", 
          "fields": ["lon", "lat"], 
          "as": ["x", "y"]
        },
        {
          "type": "filter", 
          "expr": "isFinite(datum.x) && isFinite(datum.y)"
        },
        {
          "type": "formula",
          "as": "onFrontSide",
          "expr": "cos(datum.lat * PI/180) * cos(datum.lon * PI/180 - rotateX * PI/180) >= 0"
        }
      ]
    },
    {
      "name": "connections-data",
      "source": "dataset",
      "transform": [
        {
          "type": "filter", 
          "expr": "isValid(datum.Country) && isValid(datum.Country2) && datum.Country != datum.Country2 && isValid(datum.Thickness) && datum.Thickness > 0 && isValid(datum['Thickness brut'])"
        },
        {
          "type": "aggregate",
          "groupby": ["Country", "Country2", "lat", "lon", "lat2", "lon2"],
          "ops": ["mean", "mean"],
          "fields": ["Thickness", "Thickness brut"],
          "as": ["AvgThickness", "AvgThicknessBrut"]
        }
      ]
    },
    {
      "name": "country-connections",
      "source": "connections-data",
      "transform": [
        {
          "type": "geopoint",
          "projection": "projection",
          "fields": ["lon", "lat"],
          "as": ["source_x", "source_y"]
        },
        {
          "type": "geopoint", 
          "projection": "projection",
          "fields": ["lon2", "lat2"],
          "as": ["target_x", "target_y"]
        },
        {
          "type": "formula",
          "as": "connection_path",
          "expr": "{'type': 'LineString', 'coordinates': [[datum.lon, datum.lat], [datum.lon2, datum.lat2]]}"
        },
        {
          "type": "geoshape", 
          "projection": "projection", 
          "field": "connection_path"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "bubble-size",
      "type": "sqrt",
      "domain": {"data": "country-nodes", "field": "TotalTrials"},
      "range": [100, 1200],
      "nice": true,
      "zero": true
    },
    {
      "name": "connection-width",
      "type": "linear",
      "domain": {"data": "country-connections", "field": "AvgThickness"},
      "range": [1, 8],
      "nice": true,
      "zero": true
    }
  ],
  "marks": [
    {
      "type": "shape",
      "name": "ocean",
      "from": {"data": "sphere"},
      "encode": {
        "update": {
          "fill": {"value": "#87CEEB"},
          "fillOpacity": {"value": 0.9},
          "stroke": {"value": "#4682B4"},
          "strokeWidth": {"value": 2}
        }
      },
      "transform": [
        {"type": "geoshape", "projection": "projection"}
      ]
    },
    {
      "type": "shape",
      "name": "countries-map",
      "from": {"data": "world"},
      "encode": {
        "update": {
          "fill": {"value": "#f5f5f5"},
          "stroke": {"value": "#999"},
          "strokeWidth": {"value": 0.5},
          "strokeOpacity": {"value": 0.7}
        }
      },
      "transform": [
        {"type": "geoshape", "projection": "projection"}
      ]
    },
    {
      "type": "shape",
      "name": "country-connections-lines",
      "from": {"data": "country-connections"},
      "encode": {
        "update": {
          "stroke": {"value": "#FF6B35"},
          "strokeOpacity": [
            {
              "test": "hover && (datum.Country == hover || datum.Country2 == hover)",
              "value": 0.8
            },
            {"value": 0}
          ],
          "strokeWidth": {"scale": "connection-width", "field": "AvgThickness"},
          "fill": {"value": "transparent"},
          "tooltip": {
            "signal": "hover && (datum.Country == hover || datum.Country2 == hover) ? {'From': datum.Country, 'To': datum.Country2, 'Shared Clinical Trials': format(datum.AvgThicknessBrut, ',.0f')} : null"
          }
        }
      }
    },
    {
      "type": "symbol",
      "name": "country-bubbles", 
      "from": {"data": "country-nodes"},
      "encode": {
        "update": {
          "x": {"field": "x"},
          "y": {"field": "y"},
          "size": {"scale": "bubble-size", "field": "TotalTrials"},
          "shape": {"value": "circle"},
          "fill": {"value": "#6A1B9A"},
          "fillOpacity": [
            {
              "test": "hover && datum.Country == hover",
              "value": 1.0
            },
            {
              "test": "datum.onFrontSide",
              "value": 0.85
            },
            {"value": 0}
          ],
          "stroke": {"value": "#FFFFFF"},
          "strokeWidth": {"value": 2},
          "strokeOpacity": [
            {
              "test": "datum.onFrontSide",
              "value": 1.0
            },
            {"value": 0}
          ],
          "tooltip": {
            "signal": "{'Country': datum.Country, 'Clinical Trials': format(datum.TotalTrials, ',.0f')}"
          }
        }
      }
    }
  ]
}